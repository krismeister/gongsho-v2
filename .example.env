# Gongsho machine environment. Copy to .env and adjust per machine.
# Never commit .env - it holds this machine's real values.
# The harness (tools/lib.sh) reads .env when present; built-in defaults
# apply for anything unset or when the file is absent.
GONGSHO_HOST=localhost
GONGSHO_PORT=8181
GONGSHO_SCHEME=http
# Supervisor timings (seconds).
GONGSHO_START_HEALTH_TIMEOUT=10
GONGSHO_STOP_GRACE=5
# golang-migrate version pin.
GONGSHO_MIGRATE_VERSION=v4.20.1
# CADDY_STORAGE is intentionally unset: Caddy default storage applies.
# Override here only if the default is not writable.
# CADDY_STORAGE=~/.local/share/caddy

# Gongsho machine environment. Copy to .env and adjust per machine.
# Never commit .env - it holds this machine's real values.
# The harness (tools/lib.sh) reads .env when present; built-in defaults
# apply for anything unset or when the file is absent.
# Workspace home: parent of this checkout, holding apps/ and data/.
# Default is the checkout's parent dir; uncomment only when it differs.
# GONGSHO_HOME=/home/meistro/dev/gongsho
GONGSHO_HOST=localhost
GONGSHO_PORT=8181
GONGSHO_SCHEME=http
# Supervisor timings (seconds).
GONGSHO_START_HEALTH_TIMEOUT=10
GONGSHO_STOP_GRACE=5
# golang-migrate version pin.
GONGSHO_MIGRATE_VERSION=v4.20.1
# pnpm version pin (vendored by cache-warm; v9 line only, see tools/lib.sh).
GONGSHO_PNPM_VERSION=9.15.9
# lefthook version pin (vendored by cache-warm into tools/bin/).
GONGSHO_LEFTHOOK_VERSION=v1.12.4
# Secrets master key (base64 of 32 random bytes). Managed by tools/setup
# (first run); never commit a value. The secrets API reads it from the
# process environment; the harness never logs it.
# GONGSHO_SECRETS_MASTER_KEY=
# CADDY_STORAGE is intentionally unset: Caddy default storage applies.
# Override here only if the default is not writable.
# CADDY_STORAGE=~/.local/share/caddy

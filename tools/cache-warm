#!/bin/sh
# tools/cache-warm — pre-warm Go module/build caches and compile helpers.
set -eu
VERB=cache-warm
case $0 in
    */*) _d=$(dirname -- "$0") ;;
    *) _d=$(dirname -- "$(command -v "$0" 2>/dev/null || printf '%s' "$0")") ;;
esac
[ -f "$_d/lib.sh" ] || { echo "error: cannot find lib.sh (invoked as $0)" >&2; exit 1; }
. "$_d/lib.sh"

print_help() { cat <<'EOF'
usage: tools/cache-warm

Per-template caches plus shared helpers: goa-api Go modules and
goa CLI, the pinned migrate binary into tools/bin/ (with its version
sidecar), the vendored pnpm into .cache/pnpm (plus its version
sidecar), and every node template's dependencies prefetched to the
shared store. Idempotent: re-runs skip whatever already matches.
Run once per machine and after any pin bump; startup runs this as a step.

Prerequisites: Go toolchain, npm (bootstraps vendored pnpm only).
EOF
}

case "${1:-}" in -h|--help) print_help; exit 0 ;; esac
[ $# -eq 0 ] || usage "want no arguments"
need_cmd go "Go toolchain (documented prerequisite)"

_bindir="$REPO_ROOT/tools/bin"
ensure_dir "$_bindir" || die "cannot create $_bindir"

tpl_cache_warm_template goa-api "" || die "goa-api cache warm failed (see above)"

_pinfile="$_bindir/migrate.version"
if [ -x "$_bindir/migrate" ] && [ -f "$_pinfile" ] && [ "$(cat -- "$_pinfile")" = "$MIGRATE_VERSION" ]; then
    log "migrate $MIGRATE_VERSION already built"
else
    log "building migrate $MIGRATE_VERSION"
    GOBIN="$_bindir" go install -tags 'sqlite' "github.com/golang-migrate/migrate/v4/cmd/migrate@$MIGRATE_VERSION" || die "migrate build failed (see above)"
    [ -x "$_bindir/migrate" ] || die "migrate build produced no binary"
    _ptmp=$(tmp_in_dir "$_bindir")
    printf '%s\n' "$MIGRATE_VERSION" >"$_ptmp"
    atomic_mv "$_ptmp" "$_pinfile"
    log "built $_bindir/migrate ($MIGRATE_VERSION)"
fi

_pnpm_dir="$REPO_ROOT/.cache/pnpm"
_pnpm_bin="$_pnpm_dir/node_modules/.bin/pnpm"
_pnpm_pin="$_pnpm_dir/pnpm.version"
if [ -x "$_pnpm_bin" ] && [ -f "$_pnpm_pin" ] && [ "$(cat -- "$_pnpm_pin")" = "$PNPM_VERSION" ]; then
    log "pnpm $PNPM_VERSION already provisioned"
else
    need_cmd npm "npm (bootstraps vendored pnpm)"
    log "provisioning pnpm $PNPM_VERSION"
    rm -rf -- "$_pnpm_dir"
    npm_config_cache="$REPO_ROOT/.cache/npm" npm install --prefix "$_pnpm_dir" "@pnpm/exe@$PNPM_VERSION" || die "pnpm provision failed (see above)"
    [ -x "$_pnpm_bin" ] || die "pnpm provision produced no binary"
    _ptmp2=$(tmp_in_dir "$_pnpm_dir")
    printf '%s\n' "$PNPM_VERSION" >"$_ptmp2"
    atomic_mv "$_ptmp2" "$_pnpm_pin"
    log "provisioned $_pnpm_bin ($PNPM_VERSION)"
fi
tpl_cache_warm_template react-ui "$_pnpm_bin" || die "react-ui cache warm failed (see above)"
tpl_cache_warm_template langchain-api "$_pnpm_bin" || die "langchain-api cache warm failed (see above)"
log "cache warm"

#!/bin/sh
# tools/build — compile app source to mirrored bin/ output.
set -eu
VERB=build
case $0 in
    */*) _d=$(dirname -- "$0") ;;
    *) _d=$(dirname -- "$(command -v "$0" 2>/dev/null || printf '%s' "$0")") ;;
esac
[ -f "$_d/lib.sh" ] || { echo "error: cannot find lib.sh (invoked as $0)" >&2; exit 1; }
# Absolute: this verb cds before invoking sibling verbs.
_d=$(CDPATH= cd -- "$_d" && pwd) || { echo "error: cannot resolve tools dir (invoked as $0)" >&2; exit 1; }
. "$_d/lib.sh"

print_help() { cat <<'EOF'
usage: tools/build [--if-stale] <id>

Compile app source to mirrored bin/ output with atomic promotion.
Goa APIs regenerate gen/ plus the normalized OpenAPI first; langchain
APIs typecheck and stage the compiled bundle behind a node launcher;
UIs fail on snapshot drift before regenerating clients and bundling.
Never touches proxy, DBs, or processes. With --if-stale, exit 0
without building when the output is newer than every source (drift
checks included in the skip).

Prerequisites: Go toolchain (goa APIs), Node.js with node_modules
installed (langchain APIs, UIs), yq.
EOF
}

case "${1:-}" in -h|--help) print_help; exit 0 ;; esac
_stale_only=0
_id=""
while [ $# -gt 0 ]; do
    case $1 in
        --if-stale) _stale_only=1; shift ;;
        --*) usage "unknown flag '$1'" ;;
        *) [ -z "$_id" ] || usage "unexpected argument '$1' (want exactly one ID)"
            _id=$1; shift ;;
    esac
done
[ -n "$_id" ] || usage "missing deployment ID"
validate_id "$_id"
validate_pin "$_id"
_t=$(pin_template "$_id")
_kind=$(template_kind "$_t")
_path=$(id_to_path "$_id")
_app=$(app_dir "$_id")
_bin=$(bin_dir "$_id")

_output_fresh() { # 0 when build output exists and is newer than every source
    case $_kind in
        api)
            [ -x "$_bin/api" ] || return 1
            # .env is runtime input, not build input.
            if find "$_app" -path "$_app/.env" -prune -o -type f -newer "$_bin/api" -print | grep -q .; then
                return 1
            fi
            ;;
        ui)
            [ -f "$_bin/index.html" ] || return 1
            # node_modules holds installed deps (not sources); .env is runtime.
            if find "$_app" \( -path "$_app/node_modules" -o -path "$_app/.env" \) -prune -o -type f -newer "$_bin/index.html" -print | grep -q .; then
                return 1
            fi
            ;;
        *) die "no freshness rule for kind '$_kind'" ;;
    esac
    return 0
}

if [ "$_stale_only" -eq 1 ] && _output_fresh; then
    log "build up to date for '$_id'"
    exit 0
fi

if [ "$_kind" = "api" ]; then
    if [ "$_t" = "goa-api" ]; then
        need_cmd go "Go toolchain (documented prerequisite)"
        _modline=$(cd "$_app" && go list -m 2>&1) || die "go list failed: $_modline"
        ( cd "$_app" && go run goa.design/goa/v3/cmd/goa gen "$_modline/design" ) || die "goa gen failed (see above)"
        [ -f "$_app/gen/http/openapi3.json" ] || die "goa gen emitted no gen/http/openapi3.json"
        _gtmp=$(tmp_in_dir "$_app/gen")
        cp -- "$_app/gen/http/openapi3.json" "$_gtmp" || die "spec normalize copy failed"
        atomic_mv "$_gtmp" "$_app/gen/openapi.json"
        rm -rf -- "${_bin}.new"
        mkdir -p -- "${_bin}.new" || die "cannot create build scratch"
        ( cd "$_app" && go build -o "${_bin}.new/api" . ) || die "go build failed (see above)"
        rm -rf -- "$_bin" || die "cannot replace old output"
        mv -- "${_bin}.new" "$_bin" || die "bin promotion failed"
        log "built $_bin/api"
    else
        [ -x "$_app/node_modules/.bin/tsc" ] || die "node_modules missing for '$_id' (run: install $_id)"
        ( cd "$_app" && sh "$_d/pnpm" exec tsc -b ) || die "typecheck failed (see above)"
        [ -f "$_app/dist/main.js" ] || die "typecheck emitted no dist/main.js"
        rm -rf -- "${_bin}.new"
        mkdir -p -- "${_bin}.new" || die "cannot create build scratch"
        # The launcher runs the deployment's own dist/ plus node_modules in
        # place (vendoring 90M of deps per build would triple every output).
        # The app path is baked in absolute: moving the home root needs a
        # rebuild, same as any compiled output.
        _launcher_tmp=$(tmp_in_dir "${_bin}.new")
        {
            printf '#!/bin/sh\n# Generated by tools/build: node launcher for the deployment bundle.\n'
            printf 'exec node "%s/dist/main.js" "$@"\n' "$_app"
        } >"$_launcher_tmp"
        chmod +x -- "$_launcher_tmp" || die "cannot chmod launcher"
        atomic_mv "$_launcher_tmp" "${_bin}.new/api"
        rm -rf -- "$_bin" || die "cannot replace old output"
        mv -- "${_bin}.new" "$_bin" || die "bin promotion failed"
        log "built $_bin/api (node launcher)"
    fi
else
    for _spec in "$_app/spec/"*.openapi.json; do
        [ -e "$_spec" ] || break
        _api=$(basename -- "$_spec" .openapi.json)
        _id_shape_ok "$_api" || die "snapshot '$_spec' names malformed API ID '$_api'"
        deployment_exists "$_api" || die "dangling snapshot '$_spec' (no deployment '$_api'; remove the snapshot or restore the API)"
        _pt=$(pin_template "$_api")
        [ "$(template_kind "$_pt")" = "api" ] || die "snapshot '$_spec' refers to non-API deployment '$_api'"
        _cur="$(app_dir "$_api")/gen/openapi.json"
        [ -f "$_cur" ] || die "API '$_api' has no generated spec (run: build $_api)"
        if ! cmp -s -- "$_spec" "$_cur"; then
            die "snapshot drift for '$_api': snapshot $(sha256_file "$_spec") != current $(sha256_file "$_cur"); run: tools/refresh-spec $_id $_api"
        fi
        unset _api _pt _cur
    done
    [ -x "$_app/node_modules/.bin/vite" ] || die "node_modules missing for '$_id' (run: tools/install $_id)"
    ( cd "$_app" && sh "$_d/pnpm" run build -- --base="/$_path/" ) || die "UI build failed (see above)"
    [ -f "$_app/dist/index.html" ] || die "build produced no dist/index.html"
    rm -rf -- "${_bin}.new"
    ensure_dir "$(dirname -- "${_bin}.new")" || die "cannot create build scratch"
    mv -- "$_app/dist" "${_bin}.new" || die "cannot stage bundle"
    rm -rf -- "$_bin" || die "cannot replace old bundle"
    mv -- "${_bin}.new" "$_bin" || die "bundle promotion failed"
    log "built $_bin (base /$_path/)"
fi

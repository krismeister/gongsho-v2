# Gongsho react-ui proxy stanza template (owned: proxy-stanza).
# Rendered per deployment by the harness. Variables use ${VAR} form:
#   ${PATH}  slash path of the deployment, e.g. acme/shop/ui-1
#   ${REPO}  absolute path of the repo checkout
# Shape follows docs/phase-1/proxy.md verbatim (handle_path strips the
# prefix, so inner matchers see bundle-relative paths).
handle_path /${PATH}/* {
    root * ${REPO}/bin/${PATH}
    route {
        try_files {path} /index.html
        header /index.html Cache-Control "public, max-age=0, must-revalidate"
    }
    header /assets/* Cache-Control "public, max-age=31536000, immutable"
    file_server
}

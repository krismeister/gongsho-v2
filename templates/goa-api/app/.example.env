# Example runtime environment for this deployment. Launch verbs copy it to
# `.env` on first need (ensure step), then source `.env` and export the
# pin-derived injected variables over it. The app reads only the
# environment, never this file.
#
# Injected (pin-derived, never set here):
# DB_PATH={{DB_PATH}}
# SOCKET_PATH={{SOCKET_PATH}}
# DEPLOYMENT_ID={{DEPLOYMENT_ID}}
# TEMPLATE={{TEMPLATE}}
# TEMPLATE_VERSION={{TEMPLATE_VERSION}}
#
# Settable tunables:
LOG_LEVEL=info
